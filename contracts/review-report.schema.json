{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.company.internal/governance/review-report.v1.json",
  "title": "ReviewReport",
  "description": "Structured pull request governance and security evaluation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceCommitSha",
    "evidenceManifestHash",
    "policyVersions",
    "promptVersion",
    "engine",
    "correlationId",
    "generatedAt",
    "status",
    "risk",
    "confidence",
    "findings",
    "evidenceReferences",
    "missingOrConflictingEvidence",
    "toolCallsSummary",
    "humanReviewRequired",
    "humanReviewReason"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "sourceCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "evidenceManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "policyVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "description": "Identifier of the evaluation engine or model",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PASS_WITH_NOTES", "REVIEW_REQUIRED", "BLOCKED", "INCOMPLETE"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "title",
          "severity",
          "description",
          "remediation",
          "affectedFiles"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["SECURITY", "COST", "ARCHITECTURE", "COMPLIANCE"]
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "description": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "affectedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceType", "source", "summary"],
        "properties": {
          "evidenceType": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "missingOrConflictingEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolCallsSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "status", "correlationId"],
        "properties": {
          "tool": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "humanReviewRequired": {
      "type": "boolean"
    },
    "humanReviewReason": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
