{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "targetEnvironment": {
      "value": "production"
    },
    "appServicePlanSku": {
      "value": "EP1"
    },
    "publicNetworkAccess": {
      "value": "Enabled"
    },
    "enableAuthentication": {
      "value": true
    },
    "enablePrivateNetworking": {
      "value": true
    },
    "zoneRedundant": {
      "value": true
    }
  }
}
